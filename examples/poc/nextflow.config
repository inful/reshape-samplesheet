// nextflow.config for the POC.
//
// The bulk of the config (manifest, version) lives at the repo root
// in ../../nextflow.config. This file is intentionally minimal — it
// adds a `docker` profile (default-on) so the FASTQC process can
// pull its container when no local `fastqc` binary is on PATH,
// and re-declares the manifest so the POC runs without `-C`.

manifest {
    // Inherit the parent manifest by re-reading its fields. Nextflow
    // does NOT auto-merge config from parent directories; we re-state
    // the fields explicitly so `nextflow run examples/poc/main.nf`
    // works without needing -C to point at the repo root.
    name        = 'reshape-samplesheet-poc'
    author      = 'Jone Marius Vignes'
    description = 'POC: reshape an Illumina samplesheet and feed it into nf-core/fastqc'
    version     = '0.2.1'
    nextflowVersion = '>=22.10.0'
    mainScript  = 'main.nf'
}

// Enable Docker by default so the FASTQC process can run when
// the host has no local `fastqc` binary. The fastqc process's
// `container` directive already specifies the quay.io image; we
// just need to flip the engine on. Users with a local fastqc
// can pass `-profile standard` (or just override `docker.enabled
// = false` on the command line) to skip the container pull.
docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

params {
    // Defaults so the POC has a minimal runnable form even without
    // -params-file. The requireParam() checks in main.nf still fail
    // loud if these are left empty.
    samplesheet = null
    fastq_dir   = null
    outdir      = null
    recursive   = 'false'
}
