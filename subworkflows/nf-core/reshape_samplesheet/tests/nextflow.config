// Per-test nextflow.config for the RESHAPE_SAMPLESHEET nf-test.
//
// The samplesheet_validate and samplesheet_reshape modules are thin
// wrappers around Groovy code in the parent pipeline's lib/ directory.
// They shell out to `groovy` from PATH (auto-loaded by Nextflow into
// the workflow's classpath).
//
// This config keeps the test minimal — no conda, no docker. Tests rely
// on the system Groovy (>=4.0) being on PATH.

process {
    withName: 'SAMPLESHEET_VALIDATE' {
        conda = null
        container = null
    }
    withName: 'SAMPLESHEET_RESHAPE' {
        conda = null
        container = null
    }
}