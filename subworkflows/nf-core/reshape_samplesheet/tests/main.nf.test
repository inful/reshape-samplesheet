// nf-test for RESHAPE_SAMPLESHEET sub-workflow.
//
// Generated from the nf-core sub-workflow test template. Run with:
//
//     nf-core subworkflows test reshape_samplesheet
//     nf-test test subworkflows/nf-core/reshape_samplesheet/tests/main.nf.test
//
// The test fixtures (illumina_bcl2fastq.csv + the corresponding fastqs)
// live at the project root under tests/data/ and tests/fastqs/ — they're
// the same fixtures that the bespoke Groovy test suite used before the
// nf-core restructure.
//
// Note on assertions: the CSV contains absolute fastq paths which include
// the workdir, so a strict snapshot of workflow.out would never match
// between runs (the workdir hash differs every time). Instead we assert
// on structural invariants — workflow success, presence of the csv/versions
// outputs, expected header — which give us real coverage without the
// non-determinism.

nextflow_workflow {

    name "Test Subworkflow RESHAPE_SAMPLESHEET"
    script "../main.nf"
    workflow "RESHAPE_SAMPLESHEET"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/reshape_samplesheet"
    tag "samplesheet_validate"
    tag "samplesheet_reshape"


    test("bcl2fastq - happy path - default opts") {

        when {
            params { }
            workflow {
                """
                input[0] = file('\${projectDir}/../../../../tests/data/illumina_bcl2fastq.csv')
                input[1] = file('\${projectDir}/../../../../tests/fastqs')
                input[2] = file('\${projectDir}/../../../../tests/.nfcore_test_output')
                input[3] = [:]
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.csv != null
            assert workflow.out.csv.size() == 1
            assert workflow.out.csv.first().toString().endsWith('illumina_bcl2fastq.nfcore.csv')
            assert workflow.out.versions != null
            assert workflow.out.versions.size() >= 1
        }

        cleanup {
            new File("\${projectDir}/../../../../tests/.nfcore_test_output").deleteDir()
        }
    }


    test("bcl2fastq - with strandedness column") {

        when {
            params { }
            workflow {
                """
                input[0] = file('\${projectDir}/../../../../tests/data/illumina_bcl2fastq.csv')
                input[1] = file('\${projectDir}/../../../../tests/fastqs')
                input[2] = file('\${projectDir}/../../../../tests/.nfcore_test_output')
                input[3] = [strandedness: 'reverse']
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.csv != null
            assert workflow.out.csv.size() == 1
            assert workflow.out.csv.first().toString().endsWith('illumina_bcl2fastq.nfcore.csv')
            // Read the CSV from disk. We can't snapshot the exact content
            // because absolute paths in the CSV vary per workdir, so we
            // just check the header and tail-column.
            def csvText = new File(workflow.out.csv.first().toString()).text
            assert csvText.startsWith('sample,fastq_1,fastq_2,strandedness')
            // Each sample row should end with ',reverse' (the strandedness value).
            def rows = csvText.readLines().drop(1)
            assert rows.size() == 4
            assert rows.every { it.endsWith(',reverse') }
        }

        cleanup {
            new File("\${projectDir}/../../../../tests/.nfcore_test_output").deleteDir()
        }
    }


    test("LRM - happy path - default opts") {

        when {
            params { }
            workflow {
                """
                input[0] = file('\${projectDir}/../../../../tests/data/illumina_lrm.csv')
                input[1] = file('\${projectDir}/../../../../tests/fastqs')
                input[2] = file('\${projectDir}/../../../../tests/.nfcore_test_output')
                input[3] = [:]
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.csv != null
            assert workflow.out.csv.size() == 1
            assert workflow.out.csv.first().toString().endsWith('illumina_lrm.nfcore.csv')
            // LRM samplesheet should produce the same 4 samples as bcl2fastq.
            def csvText = new File(workflow.out.csv.first().toString()).text
            def dataRows = csvText.readLines().drop(1)
            assert dataRows.size() == 4
        }

        cleanup {
            new File("\${projectDir}/../../../../tests/.nfcore_test_output").deleteDir()
        }
    }


    test("missing fastq match - should fail with IllegalArgumentException") {

        when {
            params { }
            workflow {
                """
                input[0] = file('\${projectDir}/../../../../tests/data/illumina_lrm_with_orphan.csv')
                input[1] = file('\${projectDir}/../../../../tests/fastqs')
                input[2] = file('\${projectDir}/../../../../tests/.nfcore_test_output')
                input[3] = [:]
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.errorReport.contains("sample_orphan")
        }

        cleanup {
            new File("\${projectDir}/../../../../tests/.nfcore_test_output").deleteDir()
        }
    }


    test("bcl2fastq - stub - happy path") {

        options "-stub"

        when {
            params { }
            workflow {
                """
                input[0] = file('\${projectDir}/../../../../tests/data/illumina_bcl2fastq.csv')
                input[1] = file('\${projectDir}/../../../../tests/fastqs')
                input[2] = file('\${projectDir}/../../../../tests/.nfcore_test_output')
                input[3] = [:]
                """
            }
        }

        then {
            assert workflow.success
        }

        cleanup {
            new File("\${projectDir}/../../../../tests/.nfcore_test_output").deleteDir()
        }
    }
}