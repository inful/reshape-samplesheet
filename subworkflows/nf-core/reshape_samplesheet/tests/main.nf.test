// nf-test for RESHAPE_SAMPLESHEET sub-workflow.
//
// Generated from the nf-core sub-workflow test template. Run with:
//
//     nf-core subworkflows test reshape_samplesheet
//     nf-test test subworkflows/nf-core/reshape_samplesheet/tests/main.nf.test
//
// The test fixtures (illumina_bcl2fastq.csv + the corresponding fastqs)
// live at the project root under tests/data/ and tests/fastqs/ — they're
// the same fixtures that the bespoke Groovy test suite used before the
// nf-core restructure.
//
// Note on assertions: the CSV contains absolute fastq paths which include
// the workdir, so a strict snapshot of workflow.out would never match
// between runs (the workdir hash differs every time). Instead we assert
// on structural invariants — workflow success, presence of the csv/versions
// outputs, expected header — which give us real coverage without the
// non-determinism.

nextflow_workflow {

    name "Test Subworkflow RESHAPE_SAMPLESHEET"
    script "../main.nf"
    workflow "RESHAPE_SAMPLESHEET"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/reshape_samplesheet"
    tag "samplesheet_validate"
    tag "samplesheet_reshape"


    test("bcl2fastq - happy path - default opts") {

        when {
            params { }
            workflow {
                """
                input[0] = file('\${projectDir}/../../../../tests/data/illumina_bcl2fastq.csv')
                input[1] = file('\${projectDir}/../../../../tests/fastqs')
                input[2] = file('\${projectDir}/../../../../tests/.nfcore_test_output')
                input[3] = [:]
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.csv != null
            assert workflow.out.csv.size() == 1
            assert workflow.out.csv.first().toString().endsWith('illumina_bcl2fastq.nfcore.csv')
            assert workflow.out.versions != null
            assert workflow.out.versions.size() >= 1
        }

        cleanup {
            new File("\${projectDir}/../../../../tests/.nfcore_test_output").deleteDir()
        }
    }


    test("bcl2fastq - with strandedness column") {

        when {
            params { }
            workflow {
                """
                input[0] = file('\${projectDir}/../../../../tests/data/illumina_bcl2fastq.csv')
                input[1] = file('\${projectDir}/../../../../tests/fastqs')
                input[2] = file('\${projectDir}/../../../../tests/.nfcore_test_output')
                input[3] = [strandedness: 'reverse']
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.csv != null
            assert workflow.out.csv.size() == 1
            assert workflow.out.csv.first().toString().endsWith('illumina_bcl2fastq.nfcore.csv')
            // Read the CSV from disk. We can't snapshot the exact content
            // because absolute paths in the CSV vary per workdir, so we
            // just check the header and tail-column.
            def csvText = new File(workflow.out.csv.first().toString()).text
            assert csvText.startsWith('sample,fastq_1,fastq_2,strandedness')
            // Each sample row should end with ',reverse' (the strandedness value).
            def rows = csvText.readLines().drop(1)
            assert rows.size() == 4
            assert rows.every { it.endsWith(',reverse') }
        }

        cleanup {
            new File("\${projectDir}/../../../../tests/.nfcore_test_output").deleteDir()
        }
    }


    test("LRM - happy path - default opts") {

        when {
            params { }
            workflow {
                """
                input[0] = file('\${projectDir}/../../../../tests/data/illumina_lrm.csv')
                input[1] = file('\${projectDir}/../../../../tests/fastqs')
                input[2] = file('\${projectDir}/../../../../tests/.nfcore_test_output')
                input[3] = [:]
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.csv != null
            assert workflow.out.csv.size() == 1
            assert workflow.out.csv.first().toString().endsWith('illumina_lrm.nfcore.csv')
            // LRM samplesheet should produce the same 4 samples as bcl2fastq.
            def csvText = new File(workflow.out.csv.first().toString()).text
            def dataRows = csvText.readLines().drop(1)
            assert dataRows.size() == 4
        }

        cleanup {
            new File("\${projectDir}/../../../../tests/.nfcore_test_output").deleteDir()
        }
    }


    test("missing fastq match - should fail with IllegalArgumentException") {

        when {
            params { }
            workflow {
                """
                input[0] = file('\${projectDir}/../../../../tests/data/illumina_lrm_with_orphan.csv')
                input[1] = file('\${projectDir}/../../../../tests/fastqs')
                input[2] = file('\${projectDir}/../../../../tests/.nfcore_test_output')
                input[3] = [:]
                """
            }
        }

        then {
            assert workflow.failed
            assert workflow.errorReport.contains("sample_orphan")
        }

        cleanup {
            new File("\${projectDir}/../../../../tests/.nfcore_test_output").deleteDir()
        }
    }


    test("bcl2fastq - stub - happy path") {

        options "-stub"

        when {
            params { }
            workflow {
                """
                input[0] = file('\${projectDir}/../../../../tests/data/illumina_bcl2fastq.csv')
                input[1] = file('\${projectDir}/../../../../tests/fastqs')
                input[2] = file('\${projectDir}/../../../../tests/.nfcore_test_output')
                input[3] = [:]
                """
            }
        }

        then {
            assert workflow.success
        }

        cleanup {
            new File("\${projectDir}/../../../../tests/.nfcore_test_output").deleteDir()
        }
    }


    test("bcl2fastq - samples emit - structural assertions on (meta, fastq_1, fastq_2) tuples") {

        // Runs both modules for real (no stub) so the CSV on disk
        // has actual content. Then asserts on the new `samples`
        // emit: each tuple has the right shape, single-end
        // detection works, and multi-lane samples surface as
        // multiple files in the per-direction list.
        //
        // We don't snapshot the tuple contents (the fastq paths
        // are workdir-relative and change every run). We assert
        // on shape, count, and the single-end / multi-lane
        // distinction — the load-bearing invariants.

        when {
            params { }
            workflow {
                """
                input[0] = file('\${projectDir}/../../../../tests/data/illumina_bcl2fastq.csv')
                input[1] = file('\${projectDir}/../../../../tests/fastqs')
                input[2] = file('\${projectDir}/../../../../tests/.nfcore_test_output')
                input[3] = [:]
                """
            }
        }

        then {
            assert workflow.success

            // The samples emit is the canonical hand-off. One tuple
            // per Sample_ID in the bcl2fastq fixture (4 samples).
            assert workflow.out.samples != null
            assert workflow.out.samples.size() == 4,
                "expected 4 sample tuples, got: ${workflow.out.samples.size()}"

            // Find each sample by id and assert on its shape.
            def byId = [:]
            workflow.out.samples.each { entry ->
                byId[entry[0].id] = entry
            }
            assert byId.keySet() as List == ['sample_A', 'sample_B', 'sample_C', 'sample_D'],
                "expected exactly the 4 fixture sample IDs, got: ${byId.keySet()}"

            // sample_A spans 2 lanes — both R1 and R2 lists
            // should have 2 entries, and single_end is false.
            def a = byId['sample_A']
            assert a[0].single_end == false
            assert a[1].size() == 2, "sample_A R1 should have 2 lanes, got: ${a[1].size()}"
            assert a[2].size() == 2, "sample_A R2 should have 2 lanes, got: ${a[2].size()}"
            assert a[1].every { it.toString().endsWith('.fastq.gz') },
                "every fastq_1 entry for sample_A should be a .fastq.gz file, got: ${a[1]*.toString()}"

            // sample_C is single-end — fastq_2 is empty, single_end is true.
            def c = byId['sample_C']
            assert c[0].single_end == true
            assert c[1].size() == 1
            assert c[2].isEmpty(), "sample_C R2 should be empty for single-end, got: ${c[2]}"

            // sample_B and sample_D are single-lane paired-end.
            ['sample_B', 'sample_D'].each { id ->
                def entry = byId[id]
                assert entry[0].single_end == false
                assert entry[1].size() == 1
                assert entry[2].size() == 1
            }
        }

        cleanup {
            new File("\${projectDir}/../../../../tests/.nfcore_test_output").deleteDir()
        }
    }


    test("BCLConvert V2 - happy path - default opts") {

        // Verifies the end-to-end V2 path through the sub-workflow:
        // the parser auto-detects BCLConvert V2 from the
        // [BCLConvert_Data] section marker, the validator runs the
        // same bcl2fastq structural checks on the V2 records
        // (because per-sample data structure is identical to V1),
        // and the reshape produces an nf-core CSV with all 4
        // samples. The samples emit contains the same shape as the
        // V1 case.
        //
        // This is the load-bearing integration test for V2 support:
        // it proves the auto-detection + reshape + parse round-trip
        // works end-to-end.

        when {
            params { }
            workflow {
                """
                input[0] = file('\${projectDir}/../../../../tests/data/illumina_bclconvert_v2.csv')
                input[1] = file('\${projectDir}/../../../../tests/fastqs')
                input[2] = file('\${projectDir}/../../../../tests/.nfcore_test_output')
                input[3] = [:]
                """
            }
        }

        then {
            assert workflow.success,
                "BCLConvert V2 sub-workflow failed — see the .command.err / nextflow log for details"

            // The reshape CSV should be emitted with the
            // samplesheet's basename (not the V2-specific section
            // name). The end-to-end path produces a standard
            // nf-core CSV.
            assert workflow.out.csv != null
            assert workflow.out.csv.first().toString().endsWith('illumina_bclconvert_v2.nfcore.csv')

            // The samples emit has the same shape as V1: one tuple
            // per sample, with the same per-sample structure. We
            // assert count + single-end detection + multi-lane
            // shape — the same load-bearing invariants as the V1
            // case.
            assert workflow.out.samples != null
            assert workflow.out.samples.size() == 4,
                "expected 4 V2 sample tuples, got: ${workflow.out.samples.size()}"

            def byId = [:]
            workflow.out.samples.each { entry -> byId[entry[0].id] = entry }
            assert byId.keySet() as List == ['sample_A', 'sample_B', 'sample_C', 'sample_D'],
                "expected exactly the 4 V2 fixture sample IDs, got: ${byId.keySet()}"

            def a = byId['sample_A']
            assert a[0].single_end == false
            assert a[1].size() == 2, "sample_A R1 should have 2 lanes, got: ${a[1].size()}"
            assert a[2].size() == 2, "sample_A R2 should have 2 lanes, got: ${a[2].size()}"
        }

        cleanup {
            new File("\${projectDir}/../../../../tests/.nfcore_test_output").deleteDir()
        }
    }
}