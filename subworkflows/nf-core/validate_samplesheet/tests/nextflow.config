// Per-test nextflow.config for the VALIDATE_SAMPLESHEET nf-test.
//
// The samplesheet_validate_bcl2fastq module is a thin wrapper around
// Groovy code in the parent pipeline's lib/ directory. It shells out
// to `groovy` from PATH (auto-loaded by Nextflow into the workflow's
// classpath).
//
// This config keeps the test minimal — no conda, no docker. Tests rely
// on the system Groovy (>=4.0) being on PATH.
//
// This file mirrors subworkflows/nf-core/reshape_samplesheet/tests/
// nextflow.config. Keep the two in step: enabling docker or conda at
// the repo root would otherwise make this suite quietly pull a
// container while the reshape suite keeps using system Groovy.

process {
    withName: 'SAMPLESHEET_VALIDATE_BCL2FASTQ' {
        conda = null
        container = null
    }
}