// Required parameters. Caller must set all of these via the command line
// (or via -params-file). We deliberately do not provide defaults, so a
// bare `nextflow run main.nf` fails loudly with a clear message instead
// of silently making a choice for the user.
//
// The optional flags below are DECLARED with an explicit `null` rather
// than a value. A declaration is not a default: an omitted flag still
// reads as null, so requireParam/boolParam behave exactly as they would
// if the param were undeclared. Declaring it just stops Nextflow
// printing a "WARN: access to undefined parameter" line on every run.

params {
    // Pre-bcl2fastq gate. Requires only --samplesheet; skips the
    // fastq_dir/outdir/recursive requirements entirely.
    //
    // Both spellings are declared because Nextflow normalises CLI names
    // asymmetrically: `--validate-only` (dashed) arrives as
    // params.validateOnly, while `--validate_only` (underscored)
    // arrives as params.validate_only. main.nf reads whichever is set.
    // Supporting only one would mean a caller who guesses the other
    // spelling silently falls through to the reshape path and gets a
    // confusing "Missing required parameter: --fastq_dir".
    validateOnly               = null
    validate_only              = null
    // Promote Hamming-distance index violations from warning to error
    // in --validate-only mode. Off by default (see the lib's
    // validateBcl2fastq Javadoc for why).
    hammingDistanceAsError     = null
    hamming_distance_as_error  = null
}

manifest {
    name        = 'reshape-samplesheet'
    author      = 'Jone Marius Vignes'
    description = 'Reshape an Illumina samplesheet into a generic nf-core samplesheet'
    version     = '0.4.0'
    // Developed and tested on Nextflow 26.04. The minimum is set to
    // 22.10 because that's when DSL2 + the take/main/emit block syntax
    // we use became generally available; older versions are untested.
    nextflowVersion = '>=22.10.0'
    mainScript  = 'main.nf'
}
